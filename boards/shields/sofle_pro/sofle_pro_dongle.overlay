#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

/ {
	chosen {
		zmk,kscan = &mock_kscan;
		zmk,physical-layout = &physical_layout0;
		zmk,battery = &vbatt;
		zephyr,display = &display0;
	};

	mock_kscan: mock_kscan_0 {
		compatible = "zmk,kscan-mock";
		columns = <0>;
		rows = <0>;
		events = <0>;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
		rows = <5>;
		map = <
		RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
		RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)     RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
		RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)     RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
		RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)     RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
		                        RC(4,3) RC(4,4) RC(4,5)     RC(4,9) RC(4,10) RC(4,11)
		>;
	};

	physical_layout0: physical_layout_0 {
		compatible = "zmk,physical-layout";
		display-name = "Default Layout";
		transform = <&default_transform>;
		kscan = <&mock_kscan>;
		keys
		= <&key_physical_attrs 100 100    0    0       0     0     0>
		, <&key_physical_attrs 100 100  100    0       0     0     0>
		, <&key_physical_attrs 100 100  200    0       0     0     0>
		, <&key_physical_attrs 100 100  300    0       0     0     0>
		, <&key_physical_attrs 100 100  400    0       0     0     0>
		, <&key_physical_attrs 100 100  500    0       0     0     0>
		, <&key_physical_attrs 100 100  800    0       0     0     0>
		, <&key_physical_attrs 100 100  900    0       0     0     0>
		, <&key_physical_attrs 100 100 1000    0       0     0     0>
		, <&key_physical_attrs 100 100 1100    0       0     0     0>
		, <&key_physical_attrs 100 100 1200    0       0     0     0>
		, <&key_physical_attrs 100 100 1300    0       0     0     0>
		, <&key_physical_attrs 100 100    0  100       0     0     0>
		, <&key_physical_attrs 100 100  100  100       0     0     0>
		, <&key_physical_attrs 100 100  200  100       0     0     0>
		, <&key_physical_attrs 100 100  300  100       0     0     0>
		, <&key_physical_attrs 100 100  400  100       0     0     0>
		, <&key_physical_attrs 100 100  500  100       0     0     0>
		, <&key_physical_attrs 100 100  800  100       0     0     0>
		, <&key_physical_attrs 100 100  900  100       0     0     0>
		, <&key_physical_attrs 100 100 1000  100       0     0     0>
		, <&key_physical_attrs 100 100 1100  100       0     0     0>
		, <&key_physical_attrs 100 100 1200  100       0     0     0>
		, <&key_physical_attrs 100 100 1300  100       0     0     0>
		, <&key_physical_attrs 100 100    0  200       0     0     0>
		, <&key_physical_attrs 100 100  100  200       0     0     0>
		, <&key_physical_attrs 100 100  200  200       0     0     0>
		, <&key_physical_attrs 100 100  300  200       0     0     0>
		, <&key_physical_attrs 100 100  400  200       0     0     0>
		, <&key_physical_attrs 100 100  500  200       0     0     0>
		, <&key_physical_attrs 100 100  800  200       0     0     0>
		, <&key_physical_attrs 100 100  900  200       0     0     0>
		, <&key_physical_attrs 100 100 1000  200       0     0     0>
		, <&key_physical_attrs 100 100 1100  200       0     0     0>
		, <&key_physical_attrs 100 100 1200  200       0     0     0>
		, <&key_physical_attrs 100 100 1300  200       0     0     0>
		, <&key_physical_attrs 100 100    0  300       0     0     0>
		, <&key_physical_attrs 100 100  100  300       0     0     0>
		, <&key_physical_attrs 100 100  200  300       0     0     0>
		, <&key_physical_attrs 100 100  300  300       0     0     0>
		, <&key_physical_attrs 100 100  400  300       0     0     0>
		, <&key_physical_attrs 100 100  500  300       0     0     0>
		, <&key_physical_attrs 100 100  800  300       0     0     0>
		, <&key_physical_attrs 100 100  900  300       0     0     0>
		, <&key_physical_attrs 100 100 1000  300       0     0     0>
		, <&key_physical_attrs 100 100 1100  300       0     0     0>
		, <&key_physical_attrs 100 100 1200  300       0     0     0>
		, <&key_physical_attrs 100 100 1300  300       0     0     0>
		, <&key_physical_attrs 100 100  300  430       0     0     0>
		, <&key_physical_attrs 100 100  400  430       0     0     0>
		, <&key_physical_attrs 100 100  500  430       0     0     0>
		, <&key_physical_attrs 100 100  800  430       0     0     0>
		, <&key_physical_attrs 100 100  900  430       0     0     0>
		, <&key_physical_attrs 100 100 1000  430       0     0     0>
		;
	};

	left_encoder: left_encoder {
		compatible = "alps,ec11";
		a-gpios = <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		b-gpios = <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		steps = <15>;
		status = "disabled";
	};

	right_encoder: right_encoder {
		compatible = "alps,ec11";
		a-gpios = <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		b-gpios = <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		steps = <15>;
		status = "disabled";
	};

	sensors: sensors {
		compatible = "zmk,keymap-sensors";
		sensors = <&left_encoder &right_encoder>;
	};

	mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		dc-gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;      /* PCB: EPD_DC, nice!nano D4 */
		reset-gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;     /* PCB: EPD_RST, nice!nano E6 */
		spi-dev = <&spi1>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		display0: display@0 {
			compatible = "solomon,ssd1680";
			status = "okay";
			reg = <0>;
			width = <152>;
			height = <152>;
			rotation = <90>;

			mipi-max-frequency = <4000000>;
			busy-gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>; /* PCB: EPD_BUSY, nice!nano D7 */
			tssv = <0x80>;

			full {
				border-waveform = <0x05>;
			};

			partial {
				border-waveform = <0x05>;
				dummy-line = <0x1a>;
				gate-line-width = <0x08>;
				vcom = <0x22>;
				lut = [
				00 40 00 00 00 00 00 00 00 00 00 00
				80 80 00 00 00 00 00 00 00 00 00 00
				40 40 00 00 00 00 00 00 00 00 00 00
				00 80 00 00 00 00 00 00 00 00 00 00
				00 00 00 00 00 00 00 00 00 00 00 00

				0F 00 00 00 00 00 00
				01 01 00 00 00 00 00
				00 00 00 00 00 00 00
				00 00 00 00 00 00 00
				00 00 00 00 00 00 00
				00 00 00 00 00 00 00
				00 00 00 00 00 00 00
				00 00 00 00 00 00 00
				00 00 00 00 00 00 00
				00 00 00 00 00 00 00
				00 00 00 00 00 00 00
				00 00 00 00 00 00 00

				22 22 22 22 22 22 00 00 00
				];
			};
		};
	};

	tps65_listener: tps65_listener {
		compatible = "zmk,input-listener";
		status = "okay";
		device = <&tps65>;
	};

	vbatt: vbatt {
		compatible = "zmk,battery-nrf-vddh";
	};
};

&spi1 {
	status = "okay";
	cs-gpios = <&gpio0 24 GPIO_ACTIVE_LOW>; /* PCB: EPD_CS, nice!nano B6 */
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <400000>;

	tps65: iqs5xx@74 {
		compatible = "azoteq,iqs5xx";
		reg = <0x74>;
		status = "okay";

		rdy-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;     /* PCB: TPS_RDY, nice!nano TX */
		reset-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;    /* PCB: TPS_NRST, nice!nano RX */

		one-finger-tap;
		two-finger-tap;
		press-and-hold;
		press-and-hold-time = <250>;

		scroll;
		natural-scroll-x;
		natural-scroll-y;

		bottom-beta = <5>;
		stationary-threshold = <5>;
	};
};
